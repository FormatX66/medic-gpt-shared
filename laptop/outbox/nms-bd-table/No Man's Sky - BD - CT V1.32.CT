  mov [rdi+18],#200
  MaxFuelFromZ:
  cmp dword ptr [rdi+18],00
  jg NMS.exe+7F7DDD
  jmp returnPulseOut

AOBPulseOut:
  jmp MemPulseOut
  nop
returnPulseOut:
registersymbol(AOBPulseOut)

AOBPulseFuel:
