  cmp [rdi+18],#200
  je MaxFuelFromZ
  mov [rdi+18],#200
MaxFuelFromZ:
  cmp [rdi+18],eax
  jl NMS.exe+136F1AD
  jmp returnLaunchOut

AOBLaunchOut:
  jmp MemLaunchOut
returnLaunchOut:
registersymbol(AOBLaunchOut)

AOBLaunchThruster:
  jmp MemLaunchThruster
return:
