          <AssemblerScript>{ Game   : No Man's Sky (Cursed 5.22)
  Version:
  Date   : 2024-11-03
  Author : lucar

Made by YoucefHam | Remade/Updated by lucar
  -added comments at the bottom so someone else can update in the future

}
[ENABLE]

// F3 41 0F 11 ?? ?? C3(starting bytes)
aobscanmodule(engineControls,NMS.exe,F3 0F 58 ?? ?? F3 41 0F 11 ?? ?? C3)
alloc(newmem,$1000,engineControls)
alloc(storeEngineControlBytes,6)

label(code)
label(return)

label(setValAndLoop)
label(engineControlOffsets)
label(multiplyFinalResult)

registersymbol(engineControls)
registersymbol(multiplyFinalResult)
registersymbol(storeEngineControlBytes)

storeEngineControlBytes:
 readmem(engineControls+5,6)

newmem:
  pushf
  push rax
  push rdx
  xor rax,rax
  lea rdx,[engineControlOffsets]

setValAndLoop:
  mov eax, dword ptr [rdx]
  movss xmm1,[r8+eax]
  mulss xmm1,[multiplyFinalResult]
  movss [r8+eax],xmm1
  add rdx,4
  cmp dword ptr [rdx],FFFFFFFF
  je code
  jmp setValAndLoop

code:
  pop rdx
  pop rax
  popf
  jmp return

multiplyFinalResult:
  dd (float)10  // Default = 1 || Pref = 20
engineControlOffsets:
  dd 10 14 44 64 FFFFFFFF
{Old Offsets}
{ dd 0 4 10 14 18 24 28 2C 30 40 FFFFFFFF }

engineControls+5:
  jmp newmem
  nop
return:

[DISABLE]

engineControls+5:
 readmem(storeEngineControlBytes,6)

unregistersymbol(*)
dealloc(*)

{
Original creator removed generated comments, I'll
leave some for someone in the future if they want
to update.

If you don't know how to find NMS globals in files
you'll not be able to update this script. Find a
tutorial before attempting update.

offsets
  0 = BalanceTimeMax          // removed (unsure this is correct)
  4 = BalanceTimeMin          // removed (unsure this is correct)
  10 = BoostMaxSpeed          // alreay added        (40k limit ??)
  14 = BoostThrustForce       // alread added
  18 = ReverseBrake           // not needed
  24 = FollowDerivativeGain   // removed
  28 = FollowDerivativeLimit  // removed
  2C = FollowIntegralDecay    // removed
  30 = FollowIntegralGain     // removed
  38 = FollowProportionalGain // removed
  3C = FollowProportionalLimit// removed
  40 = LowSpeedTurnDamper     // removed (multiplying this ruined turn speed)
  44 = MaxSpeed               // added myself
  58 = RollAmount             // not needed
  60 = RollForce              // not needed
  64 = ThrustForce            // added myself

^Unsure if offsets are the same as they were in echo, these are NMS 5.22 offsets^
