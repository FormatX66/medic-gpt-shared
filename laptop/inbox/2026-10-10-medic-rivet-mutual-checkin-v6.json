  "payload": {
    "title": "Phased check-in heartbeat",
    "revision_note": "Bruce: quick dispatch check at 3 and 5 mins, then at finish, never more than 30 mins between checks.",
    "heartbeat": [
      {"at": "T+3min", "check": "dispatch", "question": "Did the work actually start?"},
      {"at": "T+5min", "check": "early_progress", "question": "Is it moving?"},
      {"at": "every <=30min during run", "check": "alive", "question": "Still alive? Still progressing?"},
      {"at": "finish", "check": "completion", "question": "Done? What was the result?"}
    ],
    "rationale": "Tight early (most failures show in 1-3 min), wider during steady work, always report on completion.",
    "scope": "Protocol proposal only."
  }
}
