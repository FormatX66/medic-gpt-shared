        <CheatEntry>
          <ID>11996</ID>
          <Description>"Speed &gt;"</Description>
          <Options moActivateChildrenAsWell="1" moDeactivateChildrenAsWell="1"/>
          <Color>FF8000</Color>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>11992</ID>
              <Description>"Jetpack Speed"</Description>
              <Options moHideChildren="1"/>
              <Color>008000</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
//Player global pointers start with 33, anything after changes. last checked on NMS cursed update


aobscanmodule(forwardforce,NMS.exe,F3 0F 10 ?? ?? ?? ?? ?? 0F 10 87 ?? ?? 00 00 48 8D) // should be unique
alloc(newmem,$1000,forwardforce)// Jetpack max speed
alloc(savedForwardBytes, 8)
label(code)
label(return)


aobscanmodule(leftrightforce,NMS.exe,EB ?? F3 0F 10 05 ?? ?? ?? ?? F3 0F 11 81 ?? ?? 00 00 F3 0F 10 0D) // should be unique
alloc(newmem2,$1000,leftrightforce)// Jetpack aeriel force (or left right force)
alloc(savedLeftRightBytes, 8)
label(code2)
label(return2)


aobscanmodule(upwardforce,NMS.exe,F3 0F 10 0D ?? ?? ?? ?? F3 0F 11 89 ?? ?? 00 00 F3 0F 10 05 ?? ?? ?? ?? 48 8B 9C) // should be unique
alloc(newmem3,$1000,upwardforce)// Jetpack up force
alloc(savedUpwardBytes, 8)
label(code3)
label(return3)

label(fforce)
label(lrforce)
label(uforce)

savedForwardBytes: // readmem the bytes in memory and store it in this
readmem(forwardforce,8)

savedLeftRightBytes:// readmem the bytes in memory and store it in this
readmem(leftrightforce + 2,8)

savedUpwardBytes:// readmem the bytes in memory and store it in this
readmem(upwardforce,8)




//jetpack max forward speed
newmem:
code:
  movss xmm2,[fforce] //[NMS.exe+335B9B4]
  jmp return
fforce:
  dd (float)200 // Default is 5 || Pref is 299

forwardforce:
  jmp newmem
  nop 3
return:
  registersymbol(forwardforce)
  registersymbol(fforce)
  registersymbol(savedForwardBytes)




//aerial movement force
newmem2:
code2:
  movss xmm0,[lrforce] //[NMS.exe+335B9D4]
  jmp return2
lrforce:
  dd (float)90 // Default is 31 || Pref is 500

leftrightforce + 2:
  jmp newmem2
  nop 3

return2:
  registersymbol(leftrightforce)
  registersymbol(lrforce)
  registersymbol(savedLeftRightBytes)



//upward jetpack force
newmem3:
code3:
  movss xmm1,[uforce]//[NMS.exe+335B9EC]
  jmp return3
uforce:
  dd (float)100 //Default is 30 || Pref is 200

upwardforce:
  jmp newmem3
  nop 3
return3:
  registersymbol(upwardforce)
  registersymbol(uforce)
  registersymbol(savedUpwardBytes)
[DISABLE]

forwardforce:// readmem the from the bytes we stored and store it back into this
  readmem(savedForwardBytes,8)//db F3 0F 10 15 3D AA 1D 02

leftrightforce + 2: // readmem the from the bytes we stored and store it back into this
  readmem(savedLeftRightBytes,8)//db F3 0F 10 05 9B 3D 1F 02

upwardforce: // readmem the from the bytes we stored and store it back into this
  readmem(savedUpwardBytes,8)// idk

unregistersymbol(*)
dealloc(*)

