          <CheatEntries>
            <CheatEntry>
              <ID>12217</ID>
              <Description>"Instant Mining / No Damage To Industrial Waste/ One Shot Kills - Disable/Enable below as desired. (To the right)"</Description>
              <Color>008000</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
aobscanmodule(AOBMiningDamage,NMS.exe,89 77 50 C6 47 48 01 80)
alloc(newmem,0x400,AOBMiningDamage)

label(code)
label(return enableOneShotKill enableInstantMining oneShotKill noDamageToIndustrialWaste byPass)
registersymbol(enableOneShotKill)

newmem:
//  cmp r15,F34E6
//  jg code
  push rax
  mov rax,[rdi+A8]
  test rax,rax
  je byPass
  cmp [rax+20],1
  je noDamageToIndustrialWaste
  jmp byPass

byPass:
  pop rax
  cmp [enableOneShotKill],1
  je oneShotKill
  cmp [rdi+268],0
  jne code

oneShotKill:
  push r15
  mov r15,[rdi-50]
  mov [rdi+50],r15
  pop r15
  mov byte ptr [rdi+48],01
  jmp return

code:
  mov [rdi+50],esi
  mov byte ptr [rdi+48],01
  jmp return

noDamageToIndustrialWaste:
  pop rax
  mov [rdi+50],0
  mov r15,0
  mov byte ptr [rdi+48],01
  jmp return

enableOneShotKill:
  dd 1 // Enabled

enableInstantMining:
  dd 1 // Enabled

AOBMiningDamage:
  jmp newmem
  nop 2
return:
registersymbol(AOBMiningDamage)

[DISABLE]

AOBMiningDamage:
  db 89 77 50 C6 47 48 01

unregistersymbol(*)
dealloc(*)

